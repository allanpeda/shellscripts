      - "/sbin"
      - "/usr/"
      - "/var/"
    exclude_paths:
      - "/lost+found/"
      - "/tmp/"
      - "/var/cache/**"
      - "/var/log/**"
      - "/var/run/**"
      - "/var/spool/**"
      - "/var/tmp/**"
'
